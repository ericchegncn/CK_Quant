{
  "name": "ck-quant-desktop",
  "version": "1.0.0",
  "description": "CK Quant Desktop - 面向普通用户的智能量化工作台",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "license:admin": "electron tools/license-admin.js",
    "license:init": "node tools/license-generator.js init",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.ckquant.desktop",
    "productName": "CK Quant Desktop",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "src/**/*",
      "resources/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
